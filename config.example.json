    "external_config": "C:\\Tools\\dlsite-doujin-renamer\\config.json"
  },
  "extraction": {
    "engine": "bandizip",
    "bandizip_path": "C:\\Program Files\\Bandizip\\bz.exe",
    "password_file": "解压密码.txt",
